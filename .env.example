# Login credentials for /admin (reviews + blog posts management).
# Copy this file to .env.local (git-ignored) and set real values there,
# or set these as real environment variables on the server.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional — signs the admin session cookie. Falls back to
# ADMIN_PASSWORD if unset, so this is safe to leave out.
# ADMIN_SESSION_SECRET=some-long-random-string

# Email notification sent to the admin when a new review is published.
# Uses Gmail SMTP by default (SMTP_HOST/SMTP_PORT only needed for a
# different provider). For Gmail: enable 2FA on the account, then
# create an "App Password" at https://myaccount.google.com/apppasswords
# and use that (not the regular account password) as SMTP_PASSWORD.
# If these aren't set, the app just skips sending — review submission
# still works.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
# Optional — defaults to SMTP_USER if not set
ADMIN_EMAIL=you@gmail.com
# Optional — only needed for a non-Gmail SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_FROM=noreply@example.com
